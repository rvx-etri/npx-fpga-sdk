## How to init GIT
# source ${RVX_RELEASE_HOME}/rvx_setup.sh
# make init
# make check_python
# make fork_git
# make platform

## How to config GIT
# make config_python
# edit "rvx_python_config.mh"
# make check_python
# make config
# source ./rvx_setup.sh
# make install

ifndef RVX_UTIL_HOME
	RVX_UTIL_HOME=./rvx_util
endif

TEMPLATE_FILE = ${RVX_ENV}/release/Makefile.test_sw.template
include ${RVX_UTIL_HOME}/template_makefile.mh
-include ${RVX_ENV}/makefile/rvx_home.mh

-include ./rvx_config.mh
-include ./rvx_init.mh

TARGET_LIST=version_info.xml rvx_setup.sh.template rvx_init rvx_util rvx_ssw rvx_binary rvx_platform_example rvx_synthesizer rvx_devkit imp_class_info

########
# init #
########

_check_release_home:
	$(if $(RVX_RELEASE_HOME), , $(error RVX_RELEASE_HOME is NOT defined))

init: _check_release_home
	cp -f ${RVX_RELEASE_HOME}/rvx_init.mh .
	cp -f ${RVX_RELEASE_HOME}/rvx_python_config.mh .
	cp -f ${RVX_RELEASE_HOME}/.gitignore .
	cp -f ${RVX_RELEASE_HOME}/.gitattributes .
	@make init_makefile

init_makefile:
	@cp -f ${TEMPLATE_FILE} Makefile

fork_git: $(addprefix copy., ${TARGET_LIST})

distclean: $(addprefix distclean., ${TARGET_LIST})

$(addprefix distclean., ${TARGET_LIST}):distclean.%:
	-@git rm -rf ./$(*)
	-@rm -rf ./$(*)

$(addprefix copy., ${TARGET_LIST}):copy.%: distclean.%
	@if [ -a ${RVX_RELEASE_HOME}/$(*) ]; \
	then \
		cp -r ${RVX_RELEASE_HOME}/$(*) .; \
		git add -A ./$(*); \
	fi

platform:
	-@git rm -rf ./platform
	-@rm -rf ./platform
	cp -r ${RVX_RELEASE_HOME}/platform .

########
# user #
########

clean: clean_config

clean_config:
	-rm -f .rvx_path_config .rvx_tool_config

config: clean_config
	-cd ./rvx_binary && make config
	${PYTHON3_CMD} ${RVX_UTIL_HOME}/configure_template.py -i ./rvx_setup.sh.template -o ./rvx_setup.sh -c RVX_RELEASE_HOME=$(CURDIR)

install: config
	cd ./rvx_binary && make compiler
	make local_setup

customize::
	@echo "Customization Complete"

.PHONY: ${TARGET_LIST} platform

